# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (local dev or Hetzner VPS)
DATABASE_URL=postgresql://healthings:healthings@localhost:5432/healthings

# JWT — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-64-char-random-hex

# OTP email — console = print codes to stdout (local dev only); smtp = real mail
# NEVER ship console to a server: it writes live sign-in codes next to the email
# address into the journal, where they outlive the 10-minute expiry.
SMTP_MODE=console
# SMTP_MODE=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Healthings <otp@healthings.ai>"

# CORS (comma-separated origins; * for dev only)
CORS_ORIGINS=*

# Billing — prepaid credits + auto-reload (Stripe card on file)
INITIAL_TOKEN_GRANT=100
TOKEN_PACK_SIZE=100
TOKEN_PACK_PRICE_CENTS=500
AI_TOKENS_PER_MEAL=1
AI_TOKENS_PER_CHAT_TURN=1
SPONSORSHIP_DEFAULT_DAYS=90
AUTO_RELOAD_SIMULATE=true
# Master card-billing switch. false (alpha): full billing flow runs but every
# invoice is issued at 0 charged and no PSP is contacted. true: real charges.
BILLING_LIVE=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd
# PUBLIC_WEB_BASE_URL=https://healthings.ai
# BILLING_GRACE_TOKENS=100
# BILLING_RETRY_SCHEDULE_DAYS=1,3,5
# COGS estimate rates for the dev margin view (cents per million Gemini tokens)
# GEMINI_INPUT_COST_PER_MTOK_CENTS=30
# GEMINI_OUTPUT_COST_PER_MTOK_CENTS=250

# Gemini — mentor chat + rules summarise in clinic portal
# GEMINI_API_KEY=
