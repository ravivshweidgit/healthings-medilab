{
  "name": "healthings-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "verify:be-17": "node verify/be-17-snapshot-purge.mjs",
    "verify:be-19": "node verify/be-19-account-deletion.mjs",
    "verify:be-24": "node verify/be-24-chat-strip.mjs",
    "verify:fingerprint-hr": "node verify/backup-fingerprint-hr.mjs",
    "verify": "npm run verify:be-17 && npm run verify:be-19 && npm run verify:be-24 && npm run verify:fingerprint-hr"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.13",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
