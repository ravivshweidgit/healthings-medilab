# Copy to .env (defaults align with .env.dev). Use .env.dev / .env.prod as references.
NODE_ENV=development
STORAGE_STRATEGY=local
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
DYNAMODB_TABLE=HealthMetricsDev

# Withings OAuth
WITHINGS_CLIENT_ID=your_withings_client_id
WITHINGS_CLIENT_SECRET=your_withings_client_secret
# Must match Withings portal exactly (not exp://). Same value for authorize2, token POST, and WebBrowser redirect.
# Use a development build (`npm run start:dev` + custom dev client) so this `healthings-medilab://` scheme resolves.
WITHINGS_CALLBACK_URL=healthings-medilab://oauth

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
