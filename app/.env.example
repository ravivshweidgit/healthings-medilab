# Copy to .env (gitignored).

NODE_ENV=development

# Withings OAuth — client id is public (authorize URL). The secret lives on the
# server (`server/.env` WITHINGS_CLIENT_SECRET) and is never bundled in the APK.
WITHINGS_CLIENT_ID=your_withings_client_id
# Must match Withings portal exactly (not exp://). Same value for authorize2, token POST, and WebBrowser redirect.
# Use a development build (`npm run start:dev` + custom dev client) so this `healthings-medilab://` scheme resolves.
WITHINGS_CALLBACK_URL=healthings-medilab://oauth

# Gemini calls go through the server proxy (be-40) — the key lives in server/.env only.

# Healthings API — use https:// after enable-tls.sh on VPS (see server/DEPLOY-HETZNER.md)
HEALTHINGS_API_URL=https://api.healthings.ai
